# Shared runtime environment for Oracle infra/app compose stacks.
POSTGRES_DB=aegisai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://postgres:change-me-postgres-password@postgres:5432/aegisai
REDIS_URL=redis://redis:6379
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
SESSION_SECRET=replace-with-a-strong-session-secret
CSRF_SECRET=replace-with-a-strong-csrf-secret
SESSION_COOKIE_NAME=connect.sid
CSRF_COOKIE_NAME=csrf_token
COOKIE_DOMAIN=your-domain.example
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
WORKLOAD_ATTESTATION_KEY=REPLACE_WITH_A_DISTINCT_64_HEX_WORKLOAD_ATTESTATION_KEY
PREFLIGHT_ATTESTATION_KEY=REPLACE_WITH_A_DISTINCT_64_HEX_PREFLIGHT_ATTESTATION_KEY
CREDENTIAL_LEASE_EXPIRY_INTERVAL_MS=60000
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret
GITLAB_CLIENT_ID=gitlab-client-id
GITLAB_CLIENT_SECRET=gitlab-client-secret
ANALYSIS_CLIENT_MODE=mock
AI_PORT=8000
AI_SERVER_URL=http://ai:8000
USE_INTERNAL_AI=false
AI_ADVISORY_TIMEOUT_MS=2500
INTERNAL_API_SECRET=replace-with-a-strong-32-plus-character-internal-secret
GITHUB_APP_WEBHOOK_SECRET=replace-with-a-strong-32-plus-character-github-webhook-secret
GITLAB_WEBHOOK_SECRET=replace-with-a-strong-32-plus-character-gitlab-webhook-secret
REPORT_STORAGE_PATH=./tmp/reports
REPORT_EXPIRY_HOURS=24
REPORT_EXPIRY_INTERVAL_MS=900000
EVIDENCE_STORAGE_PATH=./tmp/evidence
EVIDENCE_EXPIRY_INTERVAL_MS=900000
TEAMS_WEBHOOK_URL=
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USERNAME=
GRAFANA_CLOUD_LOGS_PASSWORD=
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USERNAME=
GRAFANA_CLOUD_METRICS_PASSWORD=
GRAFANA_CLOUD_INSTANCE_NAME=aegisai-production
