{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "aegisai-ai-plane-boundary",
    "namespace": "aegisai-ai-plane",
    "labels": {
      "app.kubernetes.io/name": "aegisai-ai",
      "app.kubernetes.io/part-of": "aegisai",
      "aegisai.io/plane": "ai"
    }
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "aegisai-ai",
        "aegisai.io/plane": "ai"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "aegisai.io/plane": "control"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8000
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "aegisai.io/plane": "data-security"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 443
          }
        ]
      }
    ]
  }
}
