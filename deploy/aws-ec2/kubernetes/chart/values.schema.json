{
  "$schema":"https://json-schema.org/draft-07/schema#",
  "type":"object",
  "additionalProperties":false,
  "required":["images","revision","apiReplicas","frontendIngressCidrs"],
  "properties":{
    "apiReadinessPath":{"type":"string","enum":["/api/health","/api/health-unavailable"]},
    "images":{"type":"object","additionalProperties":false,"required":["api","web"],"properties":{
      "api":{"type":"string","pattern":"^docker.io/library/aegisai-api@sha256:[a-f0-9]{64}$"},
      "web":{"type":"string","pattern":"^docker.io/library/aegisai-web@sha256:[a-f0-9]{64}$"}}},
    "revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "apiReplicas":{"type":"integer","minimum":1,"maximum":2},
    "frontendIngressCidrs":{"type":"array","minItems":1,"maxItems":2,"items":{
      "type":"string","pattern":"^172\\.(18|29)\\.[0-9]{1,3}\\.[0-9]{1,3}/32$"}}
  }
}
