[Unit]
Description=Load AegisAI managed database secret into protected RAM
Wants=network-online.target
After=network-online.target
Before=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
ExecStart=/usr/bin/python3 -E -s -B /opt/aegisai/operator/materialize-database-secret.py
ExecStartPost=/usr/bin/systemctl --no-block start docker.service
TimeoutStartSec=45
UMask=0077
LimitCORE=0
MemoryMax=256M
NoNewPrivileges=yes
ProtectHome=read-only
PrivateTmp=yes

[Install]
RequiredBy=docker.service
