{
  "name": "@aegisai/private-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "corepack pnpm prisma:generate && nest build",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "start": "node dist/main.js",
    "test": "corepack pnpm --filter @aegisai/shared build && corepack pnpm prisma:generate && jest --config ./test/jest-e2e.json",
    "test:e2e": "corepack pnpm --filter @aegisai/shared build && corepack pnpm prisma:generate && jest --config ./test/jest-e2e.json",
    "typecheck": "corepack pnpm prisma:generate && tsc --noEmit",
    "prisma:format": "prisma format --schema ../../packages/private-runtime-db/prisma/schema.prisma",
    "prisma:generate": "corepack pnpm --filter @aegisai/private-runtime-db generate",
    "prisma:validate": "prisma validate --schema ../../packages/private-runtime-db/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ../../packages/private-runtime-db/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../../packages/private-runtime-db/prisma/schema.prisma"
  },
  "dependencies": {
    "@aegisai/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/client-secrets-manager": "3.1164.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "connect-redis": "9.0.0",
    "csrf-sync": "4.2.1",
    "express": "4.22.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "joi": "^18.0.2",
    "redis": "6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@aegisai/private-runtime-db": "workspace:*",
    "prisma": "5",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.3",
    "@types/express-session": "1.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
