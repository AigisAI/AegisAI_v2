  provenances      SastFindingCorrelationProvenance[]

  @@unique([correlationBatchId, sourceOccurrenceId, targetOccurrenceId], map: "SastFindingCorrelationEdge_pair_key")
  @@unique([id, correlationBatchId], map: "SastFindingCorrelationEdge_batch_edge_key")
  @@index([tenantId, repositoryBindingId, scanRequestId, kind], map: "SastFindingCorrelationEdge_scope_kind_idx")
  @@index([sourceOccurrenceId], map: "SastFindingCorrelationEdge_sourceOccurrenceId_idx")
  @@index([targetOccurrenceId], map: "SastFindingCorrelationEdge_targetOccurrenceId_idx")
}

model SastFindingCorrelationProvenance {
  id                          String                               @id
  correlationEdgeId           String
  correlationBatchId          String
  tenantId                    String
  repositoryBindingId         String
  scanRequestId               String
  attemptId                   String
  side                        SastFindingCorrelationProvenanceSide
  occurrenceId                String
  observationBatchId          String
  lineageId                   String
  normalizedFindingId         String
  scannerRunId                String
  scanner                     ScannerKind
  capability                  SastFindingCapability
  authorityLevel              SastFindingCorrelationAuthorityLevel
  severity                    Severity
  fingerprintVersion          String
  stableFingerprint           String
  fingerprintDecisionDigest   String
  sourceFindingDigest         String
  scannerVersion              String
  scannerImageDigest          String
  ruleId                      String
  ruleRevision                String
  ruleBundleDigest            String
  artifactDigest              String
  vulnerabilityDatabaseDigest String?
  provenanceDigest            String
  createdAt                   DateTime                             @default(now())

  correlationEdge SastFindingCorrelationEdge @relation(fields: [correlationEdgeId, correlationBatchId], references: [id, correlationBatchId], onDelete: Cascade, map: "SastFindingCorrelationProvenance_edge_scope_fkey")
  occurrence      SastFindingOccurrence      @relation(fields: [occurrenceId, tenantId, repositoryBindingId, scanRequestId, attemptId], references: [id, tenantId, repositoryBindingId, scanRequestId, attemptId], onDelete: Cascade, map: "SastFindingCorrelationProvenance_occurrence_scope_fkey")

  @@unique([correlationEdgeId, side], map: "SastFindingCorrelationProvenance_edge_side_key")
  @@index([occurrenceId], map: "SastFindingCorrelationProvenance_occurrenceId_idx")
  @@index([provenanceDigest], map: "SastFindingCorrelationProvenance_provenanceDigest_idx")
}

model EvidencePack {
  id             String                 @id @default(uuid())
  tenantId       String
  scanRequestId  String
  classification EvidenceClassification @default(SHORT_LIVED_EVIDENCE)
  objectKey      String
  expiresAt      DateTime
  byteSize       Int
  redacted       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scanRequest ScanRequest @relation(fields: [scanRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scanRequestId])
  @@index([expiresAt])
}

model PolicyDecision {
  id                String       @id @default(uuid())
  tenantId          String
  scanRequestId     String
  findingId         String?
  enforcementAction PolicyAction
  commentAllowed    Boolean      @default(false)
  dashboardVisible  Boolean      @default(true)
  ticketRequested   Boolean      @default(false)
  blockRequested    Boolean      @default(false)
  reasonCodes       Json
  requiredCoverage  Json
  waiverApplied     Boolean      @default(false)
  staleSuppressed   Boolean      @default(false)
  aiAdvisoryVisible Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scanRequest ScanRequest        @relation(fields: [scanRequestId], references: [id], onDelete: Cascade)
  finding     NormalizedFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scanRequestId])
  @@index([findingId])
}

model AiAdvisoryMetadata {
  id                   String   @id
  tenantId             String
  scanRequestId        String
  findingId            String
  modelVersion         String
  advisoryOnly         Boolean  @default(true)
  redactedEvidenceOnly Boolean  @default(true)
  detectorSignals      Json
  plannerSteps         Json
  confidence           Float
  detectorAdvisories   Json?
  plannerAdvisories    Json?
  modelMetadata        Json?
  fallback             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scanRequest ScanRequest @relation(fields: [scanRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scanRequestId])
  @@index([findingId])
  @@index([createdAt(sort: Desc)])
}

model Waiver {
  id             String    @id @default(uuid())
  tenantId       String
  owner          String
  reason         String
  scope          String
  expiresAt      DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
}

model Suppression {
  id            String            @id @default(uuid())
  tenantId      String
  scanRequestId String
  findingId     String?
  reason        SuppressionReason
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scanRequest ScanRequest        @relation(fields: [scanRequestId], references: [id], onDelete: Cascade)
  finding     NormalizedFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([scanRequestId])
  @@index([findingId])
}

model AuditEvent {
  id            String   @id @default(uuid())
  tenantId      String
  scanRequestId String?
  attemptId     String?
  eventType     String
  actor         String
  targetType    String
  targetId      String
  metadata      Json?
  occurredAt    DateTime @default(now())

  tenant                      Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scanRequest                 ScanRequest?                     @relation(fields: [scanRequestId], references: [id], onDelete: SetNull)
  attempt                     SastScanAttempt?                 @relation("SastScanAttemptAuditEvents", fields: [attemptId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "AuditEvent_attempt_scope_fkey")
  finalForAttempt             SastScanAttempt?                 @relation("SastScanAttemptFinalAuditEvent")
  artifactDispositionDecision SastArtifactDispositionDecision?

  @@unique([id, attemptId, tenantId], map: "AuditEvent_final_attempt_scope_key")
  // Installed concurrently by the mandatory online-schema step.
  @@unique([id, attemptId, tenantId, scanRequestId], map: "AuditEvent_artifact_disposition_scope_key")
  @@index([tenantId])
  @@index([scanRequestId])
  @@index([attemptId])
  @@index([eventType])
  @@index([occurredAt])
}
